# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Local credentials
.env

# MLflow defaults used by ad-hoc clients (the pipeline defaults under data/).
mlruns/
mlartifacts/
mlflow.db
mlflow.db-*

# Local scratch data (except the committed LAMDA feature dictionary)
data/*
!data/lamda_feature_descriptions.json

# dlt/dbt runtime state
.dlt/
target/
dbt_packages/
logs/
.user.yml

# Benchmark outputs
bench/artifacts/

# Local fitted state; keep the scaffold marker only.
.feature-platform/state/*
!.feature-platform/state/.gitkeep

# Generated observed raw metadata is snapshot-specific and can be large.
feature-platform/generated/raw_profiles/
