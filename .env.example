# Copy to .env (git-ignored) and fill in, or export these in your shell.
# Both the dlt ingestion pipeline and the dbt profile read these variables.
# Every supported authentication method is documented in docs/authentication.md.
#
# The Snowflake block feeds scripts/load_lamda.py and dbt; the R2 block at the
# bottom feeds scripts/load_lamda_r2_iceberg.py. Fill in whichever you are
# running, or both to benchmark them against each other.

SNOWFLAKE_ACCOUNT=abc12345.us-east-1
SNOWFLAKE_USER=loader_user
SNOWFLAKE_DATABASE=LAMDA
SNOWFLAKE_WAREHOUSE=LOADING_WH
SNOWFLAKE_ROLE=LOADER

# Password auth
SNOWFLAKE_PASSWORD=

# Key-pair auth (use instead of SNOWFLAKE_PASSWORD)
# SNOWFLAKE_PRIVATE_KEY_PATH=/path/to/rsa_key.p8
# SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=

# Programmatic access token (use instead of SNOWFLAKE_PASSWORD)
# SNOWFLAKE_AUTHENTICATOR=programmatic_access_token
# SNOWFLAKE_TOKEN=

# Other authenticators, e.g. externalbrowser or oauth (oauth also reads SNOWFLAKE_TOKEN)
# SNOWFLAKE_AUTHENTICATOR=

# dbt target schema for the staging/marts models
SNOWFLAKE_SCHEMA=analytics

# Only needed for gated or private Hugging Face datasets
# HF_TOKEN=

# --- Cloudflare R2 + Iceberg pipeline (scripts/load_lamda_r2_iceberg.py) ---

R2_ACCOUNT_ID=
R2_BUCKET=lamda

# R2 S3 API token (Object Read & Write) — writes the Iceberg data files
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Cloudflare API token with R2 *and* catalog permissions — authenticates to
# R2 Data Catalog, the Iceberg REST catalog
R2_CATALOG_TOKEN=

# Shown when you enable the catalog on the bucket. Derived from the account and
# bucket when left unset.
# R2_CATALOG_URI=https://catalog.cloudflarestorage.com/<account_id>/<bucket>
# R2_CATALOG_WAREHOUSE=<account_id>_<bucket>

# Overrides, rarely needed
# R2_S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# R2_REGION=auto
