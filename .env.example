# Copy to .env (git-ignored) and fill in, or export these in your shell.
# Both the dlt ingestion pipeline and the dbt profile read these variables.
# Every supported authentication method is documented in docs/authentication.md.

SNOWFLAKE_ACCOUNT=abc12345.us-east-1
SNOWFLAKE_USER=loader_user
SNOWFLAKE_DATABASE=LAMDA
SNOWFLAKE_WAREHOUSE=LOADING_WH
SNOWFLAKE_ROLE=LOADER

# Password auth
SNOWFLAKE_PASSWORD=

# Key-pair auth (use instead of SNOWFLAKE_PASSWORD)
# SNOWFLAKE_PRIVATE_KEY_PATH=/path/to/rsa_key.p8
# SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=

# Programmatic access token (use instead of SNOWFLAKE_PASSWORD)
# SNOWFLAKE_AUTHENTICATOR=programmatic_access_token
# SNOWFLAKE_TOKEN=

# Other authenticators, e.g. externalbrowser or oauth (oauth also reads SNOWFLAKE_TOKEN)
# SNOWFLAKE_AUTHENTICATOR=

# dbt target schema for the staging/marts models
SNOWFLAKE_SCHEMA=analytics

# Only needed for gated or private Hugging Face datasets
# HF_TOKEN=
